# ============================================================
#  IBM Watsonx.ai Configuration
# ============================================================
IBM_API_KEY=our_api_key_here
IBM_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://your-watsonx-url
# ============================================================
#  Flask Application Configuration
# ============================================================
SECRET_KEY=your_very_secret_flask_key_change_this
FLASK_ENV=development
FLASK_DEBUG=True


# ============================================================
#  Database Configuration
# ============================================================
# SQLite (default — no extra setup needed)
DATABASE_URL=sqlite:///course_simplifier.db

# MySQL (optional — uncomment and fill in if you prefer MySQL)
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/course_simplifier

# ============================================================
#  File Upload Configuration
# ============================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ============================================================
#  Agent Behavior Configuration (overrides AGENT_INSTRUCTIONS)
# ============================================================
AGENT_DEFAULT_LEVEL=Beginner
AGENT_LANGUAGE_STYLE=friendly
AGENT_DOMAIN=General Education
